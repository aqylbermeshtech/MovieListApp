// Template for local secrets. Copy this file to:
//   ../../Config/Secrets.xcconfig   (i.e. sibling of MovieListApp.xcodeproj, NOT inside this folder)
// and fill in real values. That location is outside git and outside Xcode's
// synced app source folder, so it is never committed or bundled into the app.
TMDB_API_KEY = your_tmdb_api_key
GUARDIAN_API_KEY = your_guardian_api_key
